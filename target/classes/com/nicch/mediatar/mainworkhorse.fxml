<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.media.MediaView?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="rootPane" prefHeight="720.0" prefWidth="1024.0" 
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="com.nicch.mediatar.MainWorkhorse">

    <top>
        <VBox fx:id="topContainer">
            <children>
                <MenuBar fx:id="mainMenuBar" style="-fx-padding: 4 10 4 10;">
                    <menus>
                        <Menu fx:id="menuFile" mnemonicParsing="false" text="File">
                            <items>
                                <MenuItem fx:id="itemOpenFile" text="Open Media File..." onAction="#handleImportAction"/>
                                <MenuItem fx:id="itemSaveProgress" text="Save Progress" onAction="#handleSaveAction"/>
                                <MenuItem fx:id="itemSaveAs" text="Save As..." onAction="#handleSaveAsAction"/>
                                <SeparatorMenuItem/>
                                <MenuItem fx:id="itemExit" text="Exit" onAction="#handleExit"/>
                            </items>
                        </Menu>
                        <Menu fx:id="menuView" mnemonicParsing="false" text="View">
                            <items>
                                <MenuItem fx:id="itemThemeSolarized" text="Solarized Light" onAction="#applySolarizedTheme"/>
                                <MenuItem fx:id="itemThemeDark" text="Classic Dark" onAction="#applyDarkTheme"/>
                                <MenuItem fx:id="itemThemeCyber" text="Cyberpunk" onAction="#applyCyberpunkTheme"/>
                                <MenuItem fx:id="itemThemeDracula" text="Dracula" onAction="#applyDraculaTheme"/>
                            </items>
                        </Menu>
                    </menus>
                </MenuBar>

                <ToolBar fx:id="actionToolBar">
                    <items>
                        <Button fx:id="toolbarBtnOpenFile" text="🗁 Open File" onAction="#handleImportAction"/>
                        <Button fx:id="toolbarBtnSaveProgress" text="💾 Save" onAction="#handleSaveAction"/>
                        <Button fx:id="toolbarBtnSaveAs" text="🖫 Save As" onAction="#handleSaveAsAction"/>
                        <Button fx:id="toolbarBtnRefresh" text="🗘 Refresh" onAction="#handleRefreshAction"/>
                    </items>
                </ToolBar>
            </children>
        </VBox>
    </top>

    <center>
        <StackPane fx:id="mainStackPane">
            
            <!-- Welcome Screen -->
            <VBox fx:id="welcomeContainer" alignment="CENTER" spacing="40.0" style="-fx-background-color: #fdf6e3;">
                <padding><Insets top="80.0" bottom="80.0"/></padding>
                <children>
                    <HBox alignment="CENTER" spacing="60.0">
                        <children>
                            <Button fx:id="cardOpenFile" contentDisplay="TOP" graphicTextGap="20.0" 
                                    onAction="#handleImportAction" prefHeight="240.0" prefWidth="280.0" 
                                    text="Open Media File" textAlignment="CENTER" wrapText="true"/>
                            <Button fx:id="cardOpenProject" contentDisplay="TOP" graphicTextGap="20.0" 
                                    onAction="#handleOpenProjectAction" prefHeight="240.0" prefWidth="280.0" 
                                    text="Open Project" textAlignment="CENTER" wrapText="true"/>
                        </children>
                    </HBox>
                </children>
            </VBox>

            <!-- Main Editor -->
            <SplitPane fx:id="mainSplitPane" dividerPositions="0.32" orientation="HORIZONTAL" visible="false">
                <!-- Left Panel -->
                <VBox fx:id="leftPanel" spacing="12.0" style="-fx-padding: 12;">
                    <children>
                        <Label text="Media Library" style="-fx-font-weight: bold; -fx-font-size: 16px;"/>
                        <TextField fx:id="searchField" promptText="Search media files..."/>
                        <ListView fx:id="mediaListView" prefHeight="2000.0"/>
                    </children>
                </VBox>

                <!-- Right Panel -->
                <VBox fx:id="rightPanel" spacing="12.0" style="-fx-padding: 12;">
                    <children>
                        <Label text="Preview" style="-fx-font-weight: bold; -fx-font-size: 16px;"/>
                        
                        <StackPane fx:id="previewPane" prefHeight="380.0" style="-fx-background-color: black;">
                            <MediaView fx:id="mediaView" fitWidth="800" fitHeight="380" preserveRatio="true"/>
                            <Label fx:id="noVideoLabel" text="Select a file and double-click or press Play" 
                                   style="-fx-text-fill: #888888; -fx-font-size: 16px;"/>
                        </StackPane>

                        <!-- Volume Control Row -->
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <Label text="🔊 Volume:"/>
                            <Slider fx:id="volumeSlider" prefWidth="180.0" min="0.0" max="1.0" value="0.8" 
                                    showTickMarks="true" showTickLabels="true"/>
                            <Label fx:id="volumeValueLabel" text="80%"/>
                            
                            <Button fx:id="btnMute" text="🔇 Mute" prefWidth="80" 
                                    onAction="#toggleMute"/>
                        </HBox>

                        <Label text="Timeline" style="-fx-font-weight: bold; -fx-font-size: 16px;"/>
                        <HBox fx:id="timelineContainer" prefHeight="140.0" 
                              style="-fx-background-color: #eee8d5; -fx-border-color: #93a1a1;">
                            <children>
                                <Label text="Timeline Area (Coming Soon)" style="-fx-padding: 30; -fx-font-style: italic;"/>
                            </children>
                        </HBox>

                        <HBox spacing="15.0" alignment="CENTER">
                            <Button fx:id="btnPlay" text="▶ Play" prefWidth="110" onAction="#playSelectedMedia"/>
                            <Button fx:id="btnPause" text="⏸ Pause" prefWidth="110" onAction="#pauseSelectedMedia"/>
                            <Button fx:id="btnExport" text="Export Video" prefWidth="140" 
                                    style="-fx-background-color: #859900; -fx-text-fill: white;"/>
                        </HBox>
                    </children>
                </VBox>
            </SplitPane>
        </StackPane>
    </center>
</BorderPane>